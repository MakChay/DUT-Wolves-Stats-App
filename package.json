    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "lucide-react": "^1.70.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.0"
