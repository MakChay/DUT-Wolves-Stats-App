# Copy to .env.local and fill in. Values in .env.local are git-ignored.
# On Vercel, add the same VITE_ variables in Project Settings → Environment Variables
# for Production, Preview and Development.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dut-wolves.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dut-wolves
VITE_FIREBASE_STORAGE_BUCKET=dut-wolves.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firestore is the source of truth. Use "mock" only for offline UI work.
VITE_DATA_MODE=firebase
