# Environment template — placeholders only; never commit real values here.
#
# Local secrets are stored outside the repository in
# %LOCALAPPDATA%\dut-wolves-stats\env and encrypted with Windows DPAPI:
#   npm run env:migrate   one-time move from a repo-local .env.local
#   npm run env:unlock    decrypt for local development
#   npm run env:lock      encrypt again and remove the plaintext copy
#   npm run env:verify    check the encrypted file without printing values
#
# On Vercel, set the VITE_ variables in Project Settings → Environment Variables.
# Never put SEED_* or other credentials in VITE_* variables: Vite embeds them in
# the public client bundle.

VITE_DATA_MODE=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Local maintenance scripts only. These are never exposed to the client bundle.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STAFF_TEMP_PASSWORD=
# FIREBASE_ADMIN_EMAIL and FIREBASE_ADMIN_PASSWORD are accepted aliases.
